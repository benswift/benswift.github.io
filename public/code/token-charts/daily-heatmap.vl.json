{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "config": {
    "background": "#1c1a1d",
    "font": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "axis": {
      "labelColor": "#aaa",
      "titleColor": "#aaa",
      "domainColor": "#363338",
      "tickColor": "#363338",
      "gridColor": "#363338",
      "gridOpacity": 0.6,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    },
    "legend": {
      "labelColor": "#e0e0e0",
      "titleColor": "#aaa",
      "labelFontSize": 11,
      "symbolType": "square"
    },
    "title": {
      "color": "#e0e0e0",
      "fontSize": 15,
      "fontWeight": 600,
      "anchor": "start",
      "subtitleColor": "#aaa",
      "subtitleFontSize": 12,
      "subtitleLineHeight": 17
    },
    "header": {
      "labelColor": "#e0e0e0",
      "labelFontSize": 11,
      "labelFontWeight": 600,
      "titleColor": "#aaa"
    },
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "Every day of agent use",
    "subtitle": "Tokens per day, 3 July 2025 to 19 August 2026. Unfilled cells are days with no session at all."
  },
  "data": {
    "url": "/code/token-charts/daily-heatmap.data.json",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "calculate": "datum.tokens === 0 ? 'none' : datum.millions < 20 ? 'under 20M' : datum.millions < 56 ? '20-56M' : datum.millions < 188 ? '56-188M' : 'over 188M'",
      "as": "bin"
    }
  ],
  "width": 760,
  "height": 126,
  "mark": {
    "type": "rect",
    "cornerRadius": 2,
    "stroke": "#1c1a1d",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "timeUnit": "yearweek",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "grid": false,
        "domain": false,
        "ticks": false,
        "labelOverlap": false,
        "labelExpr": "date(datum.value) > 7 ? '' : month(datum.value) == 0 ? timeFormat(datum.value, '%b %y') : timeFormat(datum.value, '%b')"
      }
    },
    "y": {
      "field": "date",
      "type": "ordinal",
      "timeUnit": "day",
      "axis": {
        "title": null,
        "grid": false,
        "domain": false,
        "ticks": false,
        "format": "%a",
        "labelExpr": "indexof([1,3,5], day(datum.value)) >= 0 ? timeFormat(datum.value, '%a') : ''"
      }
    },
    "color": {
      "field": "bin",
      "type": "nominal",
      "scale": {
        "domain": [
          "none",
          "under 20M",
          "20-56M",
          "56-188M",
          "over 188M"
        ],
        "range": [
          "#241f28",
          "#5b2a6b",
          "#8f2fae",
          "#be2edd",
          "#e879f9"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal",
        "symbolType": "square",
        "symbolSize": 130,
        "columnPadding": 12
      }
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "day"
      },
      {
        "field": "millions",
        "type": "quantitative",
        "title": "million tokens",
        "format": ",.0f"
      }
    ]
  }
}
