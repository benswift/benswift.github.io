{
  "name": "benswift-me",
  "version": "0.0.0",
  "description": "Ben Swift — researcher, educator, artist, developer",
  "license": "MIT",
  "author": "Ben Swift",
  "type": "module",
  "scripts": {
    "archive:urls": "pnpm exec tsx scripts/archive-event-urls.ts",
    "atproto:lexicon": "pnpm exec tsx scripts/publish-lexicon.ts",
    "atproto:livecoding": "pnpm exec tsx scripts/atproto-livecoding.ts",
    "atproto:publish": "pnpm exec tsx scripts/atproto-publish.ts",
    "build": "astro build && pagefind --site dist",
    "decks:check": "astromotion-check",
    "dev": "astro dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gen:default-hero": "pnpm exec tsx scripts/generate-hero-images.ts --default",
    "gen:hero-images": "pnpm exec tsx scripts/generate-hero-images.ts",
    "lint": "oxlint && pnpm lint:css",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:css:fix": "stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "post": "pnpm exec tsx scripts/new-post.ts",
    "preview": "astro preview",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "zenodo:collection": "pnpm exec tsx scripts/zenodo-collection.ts",
    "zenodo:deposit": "pnpm exec tsx scripts/zenodo-deposit.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@mediapipe/tasks-genai": "0.10.29",
    "astro-broken-links-checker": "^1.1.0",
    "astro-theme-anu": "git+https://gitlab.anu.edu.au/u2548636/astro-theme-anu.git#astro-theme-anu@v0.9.3&path:/packages/astro-theme-anu",
    "astro-theme-university": "github:ANUcybernetics/astro-theme-university#v0.18.0",
    "astromotion": "github:ANUcybernetics/astromotion#v0.32.1",
    "perceptron-apparatus": "github:ANUcybernetics/perceptron-apparatus#b0050a0dcfa9cfadff0011c1a7827408575a25b4",
    "remark-smartypants": "^3.0.3",
    "shaderpad": "1.0.0-beta.88",
    "sharp": "^0.35.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@atproto/api": "^0.20.44",
    "@e18e/eslint-plugin": "^0.8.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "@types/unist": "^3.0.3",
    "astro": "^7.3.4",
    "bibtex-parse": "^2.1.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pagefind": "^1.5.2",
    "puppeteer-core": "^25.11.0",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
