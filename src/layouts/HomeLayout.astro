---
import { getPosts } from "../utils/posts"
import BaseLayout from "./BaseLayout.astro"
import SiteFooter from "../components/SiteFooter.astro"
import { SITE_BASELINE_PHRASES } from "../data/hero"

interface Props {
  description?: string
  image?: string
  frontmatter?: {
    description?: string
    image?: string
  }
}

const props = Astro.props
const description = props.description ?? props.frontmatter?.description
const image = props.image ?? props.frontmatter?.image

const curatedPhrases = [
  "Ben Swift",
  "benswift",
  "Human-Scale AI",
  "Cybernetic Studio",
  "ANU School of Cybernetics",
  "LLMs Unplugged",
  "Agentic Coding Studio",
  "livecoding",
  "cybernetics",
  "researcher",
  "educator",
  "artist",
  "developer",
  "creative technologist",
  "musical livecoder",
  "TOPLAP",
  "Canberra",
  "Claude Code",
  "Extempore",
  "human-computer interaction",
  "creative computing",
]

const blogTitles = (await getPosts()).map((post) => post.data.title)

const heroPhrases = [...SITE_BASELINE_PHRASES, ...curatedPhrases, ...blogTitles]
---

<BaseLayout description={description} image={image} phrases={heroPhrases} tallHero>
  <Fragment slot="masthead">
    <h1 class="hero-name">Ben Swift</h1>
    <p class="hero-tagline">researcher, educator, artist, developer</p>
    <p class="hero-subtitle">Leading <em>Human-Scale AI</em> at the Cybernetic Studio</p>
  </Fragment>

  <div class="features">
    <a href="/blog/" class="feature-card">
      <h2>Blog</h2>
      <p>Thoughts on research, art, code, teaching and whatever else is keeping me up at night.</p>
    </a>
    <a href="/research/" class="feature-card">
      <h2>Research</h2>
      <p>Peer-reviewed publications on AI/LLMs, creative computing, and human-computer interaction.</p>
    </a>
    <a href="/teaching/" class="feature-card">
      <h2>Teaching</h2>
      <p>Courses on agentic coding, creative computing, and cybernetics.</p>
    </a>
    <a href="/livecoding/" class="feature-card">
      <h2>Livecoding</h2>
      <p>Curated and invited livecoding performances around the world.</p>
    </a>
  </div>

  <slot />
  <SiteFooter relativePath="src/pages/index.mdx" />
</BaseLayout>

<style>
  .hero-name {
    font-size: clamp(2.6rem, 1.8rem + 3vw, 3.6rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--highlight-color);
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--text-2);
    margin: 0.5rem 0;
  }

  .hero-subtitle {
    margin: 0.5rem 0 0;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem 2rem;
    margin: 2rem 0;
  }

  /* Plain linked headings, not boxed cards: content first. */
  .feature-card {
    text-decoration: none;
    color: var(--text-color);
  }

  .feature-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    transition: color 0.2s;
  }

  .feature-card:hover h2 {
    color: var(--highlight-color);
  }

  .feature-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-2);
  }
</style>
