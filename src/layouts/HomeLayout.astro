---
import { getPosts } from "../utils/posts";
import BaseLayout from "./BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_BASELINE_PHRASES } from "../data/hero";

interface Props {
  description?: string;
  image?: string;
  frontmatter?: {
    description?: string;
    image?: string;
  };
}

const props = Astro.props;
const description = props.description ?? props.frontmatter?.description;
const image = props.image ?? props.frontmatter?.image;

const blogTitles = (await getPosts()).map((post) => post.data.title);

const wallPhrases = [...SITE_BASELINE_PHRASES, ...blogTitles];
---

<BaseLayout description={description} image={image} phrases={wallPhrases} home>
  <Fragment slot="masthead">
    <h1 class="page-title">Ben Swift</h1>
    <p class="home-tagline">researcher, educator, artist, developer</p>
    <p class="home-role">Leading <em>Human-Scale AI</em> at the Cybernetic Studio</p>
  </Fragment>

  <slot />
  <SiteFooter slot="footer" relativePath="src/pages/index.mdx" />
</BaseLayout>

<style>
  .home-tagline,
  .home-role {
    margin: 0;
    color: var(--text-2);
  }
</style>
