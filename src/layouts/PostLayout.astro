---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import CitePost from "../components/CitePost.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { formatDate } from "../utils/date";
import { getHeroImage } from "../utils/hero-image";
import { SITE_BASELINE_PHRASES } from "../data/hero";

interface Props {
  title: string;
  date: string;
  tags: string[];
  description?: string;
  heroPhrases?: string[];
  atUri?: string;
  slug: string;
  relativePath?: string;
  heroImage?: ImageMetadata;
}

const {
  title,
  date,
  tags,
  description,
  heroPhrases,
  atUri,
  slug,
  relativePath,
  heroImage: heroImageOverride,
} = Astro.props;

const postDate = formatDate(new Date(date));
const postUrl = `https://benswift.me${Astro.url.pathname}`;

const heroSlug = `${date}-${slug}`;
const heroImage = heroImageOverride ?? getHeroImage(heroSlug);
const phrases = [...tags, ...(heroPhrases ?? []), ...SITE_BASELINE_PHRASES];
---

<BaseLayout
  title={title}
  description={description}
  isPost={true}
  date={date}
  atUri={atUri}
  phrases={phrases}
  heroImage={heroImage}
>
  <Fragment slot="masthead">
    <h1 class="page-title">{title}</h1>
    <div class="post-meta">
      <time class="post-date" datetime={date}>{postDate}</time>
      <TagList tags={tags} />
    </div>
  </Fragment>
  <slot />
  {atUri && <div id="juttu-comments"></div>}
  <script>
    // The juttu embed hard-codes its submit button label and re-sets it after
    // every "Posting…" cycle, so relabelling needs an observer, not a one-shot
    // rename.
    const container = document.getElementById("juttu-comments");
    // juttu shows its "Link comments" setup to every visitor when a post has no
    // Bluesky thread yet. global.css hides it unless the URL carries
    // ?link-comments, which is how Ben opens the setup.
    if (container && new URLSearchParams(location.search).has("link-comments")) {
      container.classList.add("show-linking");
    }
    if (container) {
      const relabel = () => {
        for (const btn of container.querySelectorAll(".juttu-submit-btn")) {
          if (btn.textContent === "Post comment") btn.textContent = "Post";
        }
      };
      relabel();
      new MutationObserver(relabel).observe(container, {
        childList: true,
        subtree: true,
        characterData: true,
      });
    }
  </script>
  <CitePost title={title} date={date} slug={slug} url={postUrl} atUri={atUri} />
  <SiteFooter slot="footer" relativePath={relativePath} />
</BaseLayout>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
  }

  .post-meta :global(.tag-container) {
    margin: 0;
  }

  .post-meta :global(.tag) {
    font-size: inherit;
  }
</style>
