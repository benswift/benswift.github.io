---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import Head from "../components/Head.astro";
import Nav from "../components/Nav.astro";
import Wall from "../components/Wall.astro";
import { SITE_BASELINE_PHRASES } from "../data/hero";
import defaultHero from "../assets/og-default.avif";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isPost?: boolean;
  date?: string;
  atUri?: string;
  phrases?: string[];
  heroImage?: ImageMetadata;
  // The home page's tall wall, which opens with its phrases in the order given.
  home?: boolean;
}

const {
  title,
  description,
  image,
  isPost,
  date,
  atUri,
  phrases = [...SITE_BASELINE_PHRASES],
  heroImage = defaultHero,
  home = false,
} = Astro.props;

// The first path segment picks the page's accent hue (see global.css).
const section = Astro.url.pathname.split("/").find(Boolean) ?? "home";

// WebP, not PNG: the og:image (also twitter:image) is only ever fetched by link
// unfurlers, and WebP is ~35x smaller than PNG here (~15 KB vs ~530 KB) while
// still decoding on every platform that previews links.
const ogImage = await getImage({ src: heroImage, format: "webp", width: 1200, quality: 80 });
---

<html lang="en" data-section={section}>
  <head>
    {/* Only the upright is preloaded; the obliques load when a page uses them. */}
    <Font cssVariable="--font-allo" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-recursive" />
    {/* Jost is only drawn into the Scotoma generator's canvas, but the
        @font-face has to exist site-wide for the CSS variable to resolve.
        Not preloaded: at 2.7KB it is only fetched when something renders it. */}
    <Font cssVariable="--font-jost" />
    <Head
      title={title}
      description={description}
      image={image ?? ogImage.src}
      isPost={isPost}
      date={date}
      atUri={atUri}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="frame" data-pagefind-ignore>
      <Wall phrases={phrases} size={home ? "tall" : "strip"} ordered={home} />
    </div>
    <Nav />
    <main id="main-content" tabindex="-1" data-pagefind-body>
      {Astro.slots.has("masthead") && <header class="masthead">
        <slot name="masthead" />
      </header>}
      <div class="prose">
        <slot />
      </div>
    </main>
    <slot name="footer" />
  </body>
</html>
