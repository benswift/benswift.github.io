---
import { getCollection, render } from "astro:content"
import GigLayout from "../../layouts/GigLayout.astro"

export async function getStaticPaths() {
  const gigs = await getCollection("livecoding")
  return gigs.map((gig) => ({ params: { slug: gig.id }, props: { gig } }))
}

const { gig } = Astro.props
const { Content } = await render(gig)
---

<GigLayout
  title={gig.data.title}
  date={gig.data.date}
  venue={gig.data.venue}
  venue_url={gig.data.venue_url}
  type={gig.data.type}
  event={gig.data.event}
  event_url={gig.data.event_url}
  instrument={gig.data.instrument}
  videos={gig.data.videos}
  doi={gig.data.doi}
  archived_event_url={gig.data.archived_event_url}
  archived_venue_url={gig.data.archived_venue_url}
  related_works={gig.data.related_works}
  curators={gig.data.curators}
  artists={gig.data.artists}
  description={gig.data.description}
  relativePath={gig.filePath}
>
  <Content />
</GigLayout>
