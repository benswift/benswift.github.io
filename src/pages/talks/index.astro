---
import { getCollection } from "astro:content";
import fs from "node:fs";
import { deckSlugFromPath } from "astromotion/src/deck-slug.ts";
import { parse as parseYaml } from "yaml";
import PageLayout from "../../layouts/PageLayout.astro";
import { formatDate } from "../../utils/date";

// Naming: this index lives at /talks/ while individual decks live at
// /decks/<slug>/. That split is intentional, not an oversight. /talks/ is the
// broader human-facing index --- it lists astromotion decks AND the "Earlier
// talks" archive of non-deck presentations (links out to slides/papers/video).
// /decks/<slug>/ is the astromotion artefact URL, hardcoded by the integration
// (injectRoute pattern "/decks/[...slug]"), so it can't move to /talks/ anyway.
const allTalks = await getCollection("talks");

// Auto-discover decks from src/decks/<slug>/slides.deck.mdx and read their
// frontmatter, so a new astromotion deck appears in this list with no manual
// talk stub required. A matching src/content/talks/<slug>.md (if present) still
// supplies date/event.
const deckMeta = fs
  .globSync("src/decks/**/*.deck.mdx")
  .map((file) => {
    const slug = deckSlugFromPath(`/${file}`)!;
    const src = fs.readFileSync(file, "utf8");
    const fm = src.match(/^---\n([\s\S]*?)\n---/);
    return { slug, fm: fm ? (parseYaml(fm[1]) ?? {}) : {} };
  })
  // astromotion drops `published: false` decks from the build and keeps
  // `unlisted: true` ones at their URL only, so neither belongs in this list.
  .filter(({ fm }) => fm.published !== false && fm.unlisted !== true);
const deckSlugs = new Set(deckMeta.map((d) => d.slug));

const talkBySlug = new Map(allTalks.map((t) => [t.id, t.data]));

const toDateStr = (raw: unknown) => (raw ? String(raw) : "2000-01-01");

const decks = deckMeta
  .map(({ slug, fm }) => {
    const t = talkBySlug.get(slug);
    const dateStr = toDateStr(t?.date ?? fm.date);
    return {
      slug,
      title: t?.title ?? fm.title ?? slug,
      dateStr,
      dateFormatted: formatDate(new Date(dateStr)),
      event: t?.event ?? fm.event,
    };
  })
  .sort((a, b) => b.dateStr.localeCompare(a.dateStr));

// Archive: talks with no matching deck (the older stubs), linked out to slides.
const archive = allTalks
  .filter((t) => !deckSlugs.has(t.id))
  .map((t) => {
    const dateStr = toDateStr(t.data.date);
    return {
      title: t.data.title,
      dateFormatted: formatDate(new Date(dateStr)),
      dateStr,
      event: t.data.event,
      // The title links to the first of slides, paper or video that survives.
      href: t.data.slides ?? t.data.paper ?? t.data.video,
      links: [
        { label: "slides", href: t.data.slides },
        { label: "paper", href: t.data.paper },
        { label: "video", href: t.data.video },
      ].filter((link): link is { label: string; href: string } => Boolean(link.href)),
    };
  })
  .sort((a, b) => b.dateStr.localeCompare(a.dateStr));
---

<PageLayout title="Talks" relativePath="src/pages/talks/index.astro">
  <p>Talks and presentations, newest first.</p>
  <hr />

  <ul class="post-list">
    {decks.map((talk) => <li class="post-item">
      <div class="post-item-content">
        <a href={`/decks/${talk.slug}/`} class="post-item-title">{talk.title}</a>
        <p class="post-item-meta">
          <span class="post-item-date">{talk.dateFormatted}</span>
          {talk.event && <span class="post-item-venue">{talk.event}</span>}
        </p>
      </div>
    </li>)}
  </ul>

  {archive.length > 0 && (
    <>
      <h2>Earlier talks</h2>
      <p>Older talks, kept for the archive. The slides and papers are linked where they survive.</p>
      <ul class="post-list">
        {archive.map((talk) => <li class="post-item">
          <div class="post-item-content">
            {talk.href ? (
              <a href={talk.href} class="post-item-title">{talk.title}</a>
            ) : (
              <span class="post-item-title">{talk.title}</span>
            )}
            <p class="post-item-meta">
              <span class="post-item-date">{talk.dateFormatted}</span>
              {talk.event && <span class="post-item-venue">{talk.event}</span>}
              {talk.links.length > 0 && <span class="post-item-links">
                {talk.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </span>}
            </p>
          </div>
        </li>)}
      </ul>
    </>
  )}
</PageLayout>
