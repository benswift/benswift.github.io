---
interface Props {
  relativePath?: string;
}

const { relativePath } = Astro.props;
const repoBase = "https://github.com/benswift/benswift.github.io";

const elsewhere = [
  { text: "GitHub", href: "https://github.com/benswift" },
  { text: "Bluesky", href: "https://bsky.app/profile/benswift.me" },
  { text: "LinkedIn", href: "https://www.linkedin.com/in/benjswift" },
  { text: "RSS", href: "/feed.xml" },
];
---

<footer class="site-footer frame" data-pagefind-ignore>
  <p>
    designed &amp; built with{" "}
    <a href="https://astro.build" aria-label="Built with Astro" title="Astro website">&#9889;</a
    >,{" "}
    <a
      href="https://tilleys.com.au"
      class="random-cafe"
      aria-label="See Ben's favourite coffee shops"
      title="See Ben's favourite coffee shops"
      >&#9749;</a
    >{" "} and{" "}
    <a
      href="https://www.youtube.com/watch?v=6H2FRxvsd2M"
      aria-label="What is love?"
      title="What is love?"
      >&#10084;</a
    >{" "} on unceded{" "}
    <a href="https://www.nca.gov.au/welcome-ngunnawal-country">Ngunnawal Country</a>{" "} by Ben
    Swift
  </p>

  <ul class="footer-links">
    {elsewhere.map((link) => <li><a href={link.href}>{link.text}</a></li>)}
  </ul>

  {relativePath && <ul class="footer-links">
    <li>
      <a
        rel="license"
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        class="licence"
        aria-label="Creative Commons Attribution-ShareAlike 4.0 licence"
        >cc by-sa</a
      >
    </li>
    <li><a href={`${repoBase}/blob/main/${relativePath}`}>source</a></li>
    <li><a href={`${repoBase}/commits/main/${relativePath}`}>history</a></li>
  </ul>}
</footer>

<style>
  .site-footer {
    margin-block: 4rem 2.5rem;
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .site-footer p {
    max-inline-size: var(--measure);
    margin: 0 0 0.75rem;
  }

  .site-footer p a {
    text-decoration: underline;
    text-decoration-color: var(--divider);
    text-underline-offset: 0.2em;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-links li {
    margin: 0;
  }
</style>

<script>
  const cafeUrls = [
    "https://tilleys.com.au",
    "https://www.harvestcoffee.com.au",
    "https://www.facebook.com/goodbrothercbr",
    "https://frontgallerycafe.com",
    "https://redbrick.coffee",
  ];

  for (const el of document.querySelectorAll(".random-cafe")) {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.href = cafeUrls[Math.floor(Math.random() * cafeUrls.length)];
    });
  }
</script>
