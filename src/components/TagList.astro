---
interface Props {
  tags: string[];
  // Plain "#tag" text links rather than pills, for long lists of posts.
  quiet?: boolean;
}

const { tags, quiet = false } = Astro.props;
---

{tags.length > 0 && <p class:list={["tag-container", { quiet }]}>
  {tags.map((tag) => <a href={`/blog/tag/${tag}/`} class="tag">{tag}</a>)}
</p>}

<style>
  .tag-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0;
  }

  .tag {
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background-color: var(--bg-soft);
    font-size: var(--step--1);
    color: var(--text-2);
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .tag:hover {
    background-color: var(--brand-soft);
    color: var(--accent-ink);
  }

  .quiet {
    gap: 0 0.75rem;
    margin: 0.3rem 0 0;
  }

  .quiet .tag {
    padding: 0;
    background: none;
    color: var(--text-3);
  }

  .quiet .tag::before {
    content: "#";
  }

  .quiet .tag:hover {
    background: none;
  }
</style>
