---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && <p class="tag-container">
  {tags.map((tag) => <a href={`/blog/tag/${tag}/`} class="tag">{tag}</a>)}
</p>}

<style>
  .tag-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.8rem;
    margin: 0.3rem 0 0;
  }

  .tag {
    font-size: var(--step--1);
    color: var(--text-3);
    text-decoration: none;
  }

  .tag::before {
    content: "#";
  }

  .tag:hover {
    color: var(--accent-ink);
  }
</style>
