---
import TagList from "./TagList.astro";
import { formatDate } from "../utils/date";
import type { Post } from "../utils/posts";

interface Props {
  posts: Post[];
  // On a tag page every row carries that tag, so leave it off the chips.
  hideTag?: string;
}

const { posts, hideTag } = Astro.props;
---

<ul class="post-list" data-pagefind-ignore>
  {posts.map((post) => {
    const tags = post.data.tags.filter((tag) => tag !== hideTag);
    return <li class="post-item">
      <div class="post-item-content">
        <h2 class="post-item-title"><a href={post.url}>{post.data.title}</a></h2>
        <span class="post-item-date">{formatDate(new Date(post.date))}</span>
        {tags.length > 0 && <div class="post-item-tags">
          <TagList tags={tags} />
        </div>}
        <p class="post-item-excerpt">{post.data.description}</p>
      </div>
    </li>;
  })}
</ul>
