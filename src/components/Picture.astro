---
import { Picture as AstroPicture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { readFile } from "node:fs/promises";
import { isAnimatedWebp } from "@/utils/animated-image";

interface Props {
  file: string;
  alt?: string;
  credit?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  // Run the photo edge to edge across the viewport, cropped to a band.
  bleed?: boolean;
}

const { file, alt = "", credit, loading = "lazy", fetchpriority, bleed = false } = Astro.props;

// Discover post images at build time. Path is relative to
// src/assets/post-images/ (e.g. "posts/foo.webp", "livecoding/bar.webp").
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/post-images/**/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true, import: "default" },
);

const key = `/src/assets/post-images/${file}`;
const image = imageModules[key]?.default ?? (imageModules[key] as unknown as ImageMetadata);

if (!image) {
  throw new Error(
    `Picture: image not found at ${key}. Available keys start with "/src/assets/post-images/".`,
  );
}

// sharp doesn't animate, so anything animated loses all but its first frame
// when re-encoded. Pass those through raw instead. GIFs are assumed animated
// (the pipeline gains little on them either way); animated WebP is detected
// from the source bytes, so a still WebP still gets the full treatment.
const isAnimated =
  image.format === "gif" || (image.format === "webp" && isAnimatedWebp(await readFile(`.${key}`)));
---

<figure class:list={["picture-container", { bleed }]}>
  {isAnimated ? (
    <img src={image.src} alt={alt} loading={loading} width={image.width} height={image.height} />
  ) : (
    <AstroPicture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )}
  {credit && <figcaption class="picture-credit">{credit}</figcaption>}
</figure>

<style>
  .picture-container {
    position: relative;
    margin: 1rem 0;
  }

  .picture-container img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Full bleed: as wide as the viewport, whatever column it sits in (its
     container is centred, so half the difference pulls it to the edge). */
  .picture-container.bleed {
    inline-size: 100vw;
    max-inline-size: none;
    margin: 2rem calc(50% - 50vw);
  }

  .picture-container.bleed img {
    block-size: min(72svh, 56vw);
    object-fit: cover;
    border-radius: 0;
  }

  .bleed .picture-credit {
    inset-inline-end: var(--gutter);
  }

  .picture-credit {
    position: absolute;
    bottom: 1em;
    right: 1em;
    color: #ffffff;
    font-style: italic;
    font-size: var(--step--1);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .picture-credit::before {
    content: "photo: ";
  }
</style>
