---
import {
  hashString,
  makeStylist,
  mulberry32,
  prepPhrases,
  shuffled,
  tokenise,
  wallHtml,
} from "./wall";

interface Props {
  phrases: string[];
  // Keep the given phrase order for the opening lines instead of shuffling.
  ordered?: boolean;
}

const { phrases, ordered = false } = Astro.props;

// Enough to fill the wall at any width; the typist trims what doesn't fit.
const OPENING_COUNT = 10;

const pool = prepPhrases(phrases);
const random = mulberry32(hashString(Astro.url.pathname));
const pickStyle = makeStylist(random);
const opening = (ordered ? pool : shuffled(pool, random))
  .slice(0, OPENING_COUNT)
  .map((phrase) => ({ tokens: tokenise(phrase), ...pickStyle() }));
---

<div class="wall" data-phrases={JSON.stringify(pool)}>
  <p class="wall-inner" aria-hidden="true" set:html={wallHtml(opening)} />
</div>

<script>
  import { mountWall } from "./wall-typist";

  const wall = document.querySelector<HTMLElement>(".wall");
  // The stop/play control lives in the nav (Nav.astro).
  const toggle = document.querySelector<HTMLButtonElement>(".wall-toggle");
  if (wall) mountWall(wall, toggle);
</script>

<style is:global>
  /* A fixed number of lines of very large type. The height is reserved in
     the server-rendered markup, so nothing shifts when the typist starts. */
  .wall {
    --wall-lines: 2;

    overflow: hidden;
    margin-block: 1rem 0.75rem;
    /* Room for ascenders and descenders, which overhang the tight lines. */
    padding-block: 0.14em;
    block-size: calc(var(--wall-lines) * 1lh + 0.28em);
    font-size: clamp(1.7rem, 1rem + 2.4vw, 2.9rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    user-select: none;
  }

  .wall-inner {
    margin: 0;
  }

  .wall-word {
    white-space: nowrap;
  }

  .wall-rest {
    visibility: hidden;
  }

  .wall-caret {
    display: inline-block;
    inline-size: 0.07em;
    block-size: 0.74em;
    margin-inline-start: 0.05em;
    background: currentcolor;
    translate: 0 0.04em;
  }

  .wall[data-typing] .wall-caret {
    animation: wall-caret 1s steps(1) infinite;
  }

  @keyframes wall-caret {
    50% {
      opacity: 0;
    }
  }

  @media print {
    .wall {
      display: none;
    }
  }

  /* Set by the typist for `?wall-capture`: the wall alone, filling the
     viewport, for scripts/generate-hero-images.ts to screenshot. */
  [data-wall-capture] .wall {
    --wall-lines: 5;

    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    align-content: center;
    block-size: auto;
    padding: 3.5rem 4rem;
    background: var(--background-color);
    font-size: 6.1rem;
    line-height: 0.92;
  }
</style>
