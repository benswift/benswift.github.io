---
import Search from "./Search.astro";

const navLinks = [
  { text: "Blog", href: "/blog/" },
  { text: "Research", href: "/research/" },
  { text: "Livecoding", href: "/livecoding/" },
  { text: "Teaching", href: "/teaching/" },
  { text: "Bio", href: "/bio/" },
];

const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<header class="site-header frame" data-pagefind-ignore>
  <nav class="site-nav" aria-label="Main">
    <a href="/" class="site-mark" aria-label="benswift.me home">
      <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
        <path
          d="M8,0 L64,0 L64,56 A8,8 0 0,1 56,64 L8,64 A8,8 0 0,1 0,56 L0,8 A8,8 0 0,1 8,0 Z"
          fill="#be2edd"
        />
        <line x1="32" y1="6" x2="32" y2="58" stroke="rgba(255,255,255,0.15)" stroke-width="0.75" />
        <line x1="6" y1="32" x2="58" y2="32" stroke="rgba(255,255,255,0.15)" stroke-width="0.75" />
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="white"
          text-anchor="middle"
          dominant-baseline="central"
          x="16"
          y="18"
          >b</text
        >
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="white"
          text-anchor="middle"
          dominant-baseline="central"
          x="48"
          y="18"
          >s</text
        >
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="white"
          text-anchor="middle"
          dominant-baseline="central"
          x="16"
          y="46"
          >m</text
        >
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="white"
          text-anchor="middle"
          dominant-baseline="central"
          x="48"
          y="46"
          >e</text
        >
      </svg>
    </a>

    <ul class="nav-links">
      {navLinks.map((link) => <li>
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.text}</a>
      </li>)}
    </ul>

    <Search />
  </nav>
</header>

<style>
  /* One row; on a phone the links wrap onto a second row under the mark and
     the search button, so there is no menu to open. */
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    padding-block: 1.25rem;
  }

  .site-mark {
    display: flex;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }

  .nav-links li {
    margin: 0;
  }

  .nav-links a {
    display: block;
    padding-block: 0.25rem;
  }

  /* The current section is underlined in its own hue. */
  .nav-links a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent-strong);
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.3em;
  }

  .site-nav :global(.search-container) {
    margin-inline-start: auto;
  }

  @media (width < 40rem) {
    .nav-links {
      order: 1;
      flex-basis: 100%;
      gap: 0.25rem 0.8rem;
      font-size: 0.94rem;
    }
  }
</style>
