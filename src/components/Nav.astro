---
import Search from "./Search.astro";

const navLinks = [
  { text: "Blog", href: "/blog/" },
  { text: "Research", href: "/research/" },
  { text: "Livecoding", href: "/livecoding/" },
  { text: "Teaching", href: "/teaching/" },
  { text: "Bio", href: "/bio/" },
];

const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<header class="site-header frame" data-pagefind-ignore>
  <nav class="site-nav" aria-label="Main">
    <a href="/" class="site-mark" aria-label="benswift.me home">
      <svg width="20" height="20" viewBox="0 0 64 64" aria-hidden="true">
        <path
          d="M8,0 L64,0 L64,56 A8,8 0 0,1 56,64 L8,64 A8,8 0 0,1 0,56 L0,8 A8,8 0 0,1 8,0 Z"
          fill="currentColor"
        />
        <line
          x1="32"
          y1="6"
          x2="32"
          y2="58"
          stroke="var(--background-color)"
          stroke-opacity="0.2"
          stroke-width="0.75"
        />
        <line
          x1="6"
          y1="32"
          x2="58"
          y2="32"
          stroke="var(--background-color)"
          stroke-opacity="0.2"
          stroke-width="0.75"
        />
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="var(--background-color)"
          text-anchor="middle"
          dominant-baseline="central"
          x="16"
          y="18"
          >b</text
        >
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="var(--background-color)"
          text-anchor="middle"
          dominant-baseline="central"
          x="48"
          y="18"
          >s</text
        >
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="var(--background-color)"
          text-anchor="middle"
          dominant-baseline="central"
          x="16"
          y="46"
          >m</text
        >
        <text
          font-family="inherit"
          font-size="20"
          font-weight="700"
          fill="var(--background-color)"
          text-anchor="middle"
          dominant-baseline="central"
          x="48"
          y="46"
          >e</text
        >
      </svg>
    </a>

    <ul class="nav-links">
      {navLinks.map((link) => <li>
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.text}</a>
      </li>)}
    </ul>

    <Search />
  </nav>
</header>

<style>
  /* One thin line under the wall, in small type, so the wall has the top of
     the page to itself. The links wrap on a phone; there is no menu to open. */
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
    padding-block: 0.6rem;
    border-block-start: 1px solid var(--divider);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .site-mark {
    display: flex;
    color: var(--text-color);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links li {
    margin: 0;
  }

  .nav-links a {
    display: block;
    padding-block: 0.2rem;
  }

  /* The current section is in full ink, and underlined so it doesn't rest
     on colour alone. */
  .nav-links a[aria-current="page"] {
    color: var(--text-color);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .site-nav :global(.search-container) {
    margin-inline-start: auto;
  }

  @media (width < 26rem) {
    .site-nav,
    .nav-links {
      column-gap: 0.6rem;
      font-size: 0.8rem;
    }
  }
</style>
