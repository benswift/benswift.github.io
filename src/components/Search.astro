---
---

<div class="search-container">
  <button
    class="search-toggle"
    title="Search (Ctrl+K)"
    commandfor="search-dialog"
    command="show-modal"
  >
    <span aria-hidden="true">⌕</span> Search
  </button>

  <dialog id="search-dialog" class="search-dialog" aria-label="Search" closedby="any">
    <search>
      <div id="pagefind-search"></div>
    </search>
    <button
      class="search-close"
      aria-label="Close search"
      commandfor="search-dialog"
      command="close"
    >
      <kbd>Esc</kbd>
    </button>
  </dialog>
</div>

<style>
  .search-toggle {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0;
    border: none;
    background: none;
    color: var(--text-2);
    font-size: inherit;
    font-weight: 550;
    cursor: pointer;
    transition: color 0.15s;
  }

  .search-toggle:hover {
    color: var(--text-color);
  }

  .search-dialog {
    border: 1px solid var(--divider);
    border-radius: var(--radius-lg);
    background: var(--background-color);
    color: var(--text-color);
    max-width: 36rem;
    width: 90vw;
    /* Room above the input for the Esc button. */
    padding: 2.75rem 1.5rem 1.5rem;
    margin: 10vh auto;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 25%);
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 35%);
  }

  .search-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: 1px solid var(--divider);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--text-2);
    padding: 0.125rem 0.375rem;
    font-size: 0.75rem;
  }

  .search-close:hover {
    color: var(--text-color);
  }
</style>

<style is:global>
  /* Pagefind UI reads these custom properties; the rules below cover what
     they don't reach. */
  #pagefind-search {
    --pagefind-ui-font: var(--font-family-base);
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent-ink);
    --pagefind-ui-text: var(--text-color);
    --pagefind-ui-background: var(--bg-soft);
    --pagefind-ui-border: var(--divider);
    --pagefind-ui-tag: var(--bg-soft);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
  }

  .pagefind-ui__search-input {
    border-radius: var(--radius-md) !important;
  }

  .pagefind-ui__search-clear {
    color: var(--text-2) !important;
    background: var(--bg-soft) !important;
  }

  .pagefind-ui__message {
    color: var(--text-2) !important;
  }

  .pagefind-ui__result-link {
    color: var(--text-color) !important;
  }

  .pagefind-ui__result-link:hover {
    color: var(--brand-1) !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--text-2) !important;
  }

  /* Pagefind reverts mark to the browser default (yellow); the id outranks it. */
  #pagefind-search mark {
    background: none;
    color: var(--text-color);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent-strong);
    text-underline-offset: 0.2em;
  }

  .pagefind-ui__button {
    background: var(--text-color) !important;
    color: var(--background-color) !important;
  }
</style>

{/*
  Bundled (non-inline) so it loads from /_astro/... and complies with our
  meta CSP's strict script-src 'self'. Module scripts are deferred, which is
  fine: the search toggle isn't usable until the user interacts.
*/}
<script>
  type PagefindUIConstructor = new (opts: {
    element: string;
    showSubResults?: boolean;
    showImages?: boolean;
  }) => unknown;

  const dialog = document.querySelector<HTMLDialogElement>("#search-dialog")!;
  let pagefindLoaded: Promise<void> | undefined;

  function loadPagefind() {
    pagefindLoaded ??= (async () => {
      try {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "/pagefind/pagefind-ui.css";
        document.head.appendChild(link);

        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        await new Promise<void>((resolve, reject) => {
          script.onload = () => resolve();
          script.onerror = () => reject(new Error("pagefind-ui.js failed to load"));
          document.head.appendChild(script);
        });

        const { PagefindUI } = window as unknown as { PagefindUI: PagefindUIConstructor };
        new PagefindUI({ element: "#pagefind-search", showSubResults: true, showImages: false });
      } catch {
        document.getElementById("pagefind-search")!.textContent =
          "Search is not available in dev mode.";
      }
    })();
    return pagefindLoaded;
  }

  // The toggle and close buttons open and close the dialog declaratively
  // (commandfor/command); this just loads Pagefind on first open and focuses
  // its input.
  dialog.addEventListener("toggle", async (event) => {
    if ((event as ToggleEvent).newState !== "open") return;
    await loadPagefind();
    dialog.querySelector<HTMLInputElement>(".pagefind-ui__search-input")?.focus();
  });

  document.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === "k") {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else dialog.showModal();
    }
  });

  // Light-dismiss fallback for browsers without closedby support (Safari).
  if (!("closedBy" in HTMLDialogElement.prototype)) {
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const insideContent =
        rect.top <= event.clientY &&
        event.clientY <= rect.bottom &&
        rect.left <= event.clientX &&
        event.clientX <= rect.right;
      if (!insideContent) dialog.close();
    });
  }
</script>
